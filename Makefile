# SPDX-License-Identifier: GPL-2.0-only
#
# Makefile - JexOS build system
#
# Targets:
#   all             Build kernel + disk image + boot image (default)
#   run             Boot in QEMU via GRUB (GUI) [default]
#   run-native      Boot in QEMU via the custom stage-1/2 bootloader
#   boot            Alias for run-native
#   clean           Remove build artifacts
#   distclean       Remove everything (incl. build directory)
#   docs            Generate Doxygen HTML documentation
#   iso             Build bootable GRUB ISO
#   help            Show this help
#
# Options:
#   V=1             Verbose output (show full commands)
#   DEBUG=1         Build with ftrace instrumentation

## Toolchain 
CC        = gcc
AS        = as
LD        = ld
HOSTCC    = gcc
OBJCOPY   = objcopy
NM        = nm
PYTHON    = python3
QEMU      = qemu-system-i386

## QEMU options shared by all run targets
# out.mixing-engine=off matters: with QEMU's software mixer in the path the
# AC'97 voice is fed a full mixer window per audio timer tick, which runs the
# stream ~2.3x faster than the codec rate.  Bypassing it hands the samples to
# the backend and the DMA position advances at the programmed 44.1 kHz.
# It also turns fixed settings off, so each voice opens the backend at its own
# format -- no resampler in the path.  That works because pa accepts
# 44.1 kHz / s16 / stereo and PipeWire converts to the device rate itself;
# a backend that insists on 48 kHz would play the stream fast.
QEMU_OPTS = -serial stdio \
            -smp 2 \
            -machine pcspk-audiodev=audio0 \
            -audiodev pa,id=audio0,out.mixing-engine=off \
            -netdev user,id=net0,hostfwd=tcp::8080-:80 \
            -device rtl8139,netdev=net0 \
            -device AC97,audiodev=audio0

## Architecture 
# -mno-80387 is a correctness guard, not an optimization.  Nothing saves the
# x87 state across a task switch, so a float in kernel C would silently
# corrupt whatever the preempted task had in its registers.  With the flag,
# such a float compiles to a soft-float call that nothing provides and the
# link fails -- loud, immediate, and impossible to miss.  See TODO.md
# "FPU/SSE State" before removing it.
CFLAGS    = -m32 -march=i486 -ffreestanding -std=gnu99 -fno-pie -fno-stack-protector
CFLAGS   += -mno-80387
CFLAGS   += -O2 -Wall -Wextra
CFLAGS   += -fno-omit-frame-pointer
CFLAGS   += -Isrc/include -Isrc/tests
ASFLAGS   = --32
LDFLAGS   = -m elf_i386 -T linker.ld -nostdlib

# ftrace support (see src/debug/ftrace.c)
ifeq ($(DEBUG),1)
CFLAGS += -finstrument-functions
endif

# Scheduler switch tracing: per-context-switch SAVE2/SW2 dumps for PID 2.
# Off by default -- it floods serial (~2000 lines/60s idle) and buries the
# boot log.  Enable with `make SWITCH_TRACE=1` when debugging the
# switch/trampoline path.
ifeq ($(SWITCH_TRACE),1)
CFLAGS += -DJEXOS_SWITCH_TRACE
endif

# Mutex-path counters (MTX f=/MTX-ALIVE) emitted from the tick handlers.
# Off by default -- two lines every ~200 slices forever.  Enable with
# `make MUTEX_TRACE=1` when a mutex wedge needs the transition counters.
ifeq ($(MUTEX_TRACE),1)
CFLAGS += -DJEXOS_MUTEX_TRACE
endif

## Output files
KERNEL    = jexos.bin
IMG       = jexos.img
ISO       = jexos.iso
DELIVERY  = jexosg.img
BUILD     = build
OBJ_DIR   = $(BUILD)/obj
BOOT_IMG  = jexos.boot.img

## Build flavors: make / make debug / make test
#   debug: JEXOS_DEBUG  -- insanely verbose serial logging, normal shell boot
#   test:  JEXOS_SELFTEST -- same core + boots straight into the self-test
#          suite and exits QEMU via the isa-debug-exit port when done.
#   Each flavor gets its own object dir and artifact names so flavors
#   never clobber each other's stale objects.
FLAVOR =
ifeq ($(FLAVOR),debug)
CFLAGS   += -DJEXOS_DEBUG
KERNEL    = jexos-debug.bin
IMG       = jexos-debug.img
ISO       = jexos-debug.iso
DELIVERY  = jexosg-debug.img
OBJ_DIR   = $(BUILD)/obj-debug
endif
ifeq ($(FLAVOR),test)
CFLAGS   += -DJEXOS_SELFTEST -DJEXOS_DEBUG
KERNEL    = jexos-test.bin
IMG       = jexos-test.img
ISO       = jexos-test.iso
DELIVERY  = jexosg-test.img
OBJ_DIR   = $(BUILD)/obj-test
endif
BOOTSECT  = $(BUILD)/bootsect.bin
LOADER    = $(BUILD)/loader.bin
LOADER_ELF = $(BUILD)/loader.elf

## Source discovery
SRC_C     = $(shell find src -name '*.c' ! -path '*/lib/type.c')
SRC_S     = $(shell find src/arch -name '*.s' ! -name 'bootsect.s' ! -name 'loader.s')
OBJECTS   = $(patsubst src/%.c, $(OBJ_DIR)/%.o, $(SRC_C)) \
            $(patsubst src/%.s, $(OBJ_DIR)/%.o, $(SRC_S))

## Dependency files (auto-generated by -MMD) 
DEPS      = $(OBJECTS:.o=.d)

## Host tools 
MKJEXFS   = $(BUILD)/tools/mkjexfs
GEN_KS    = $(BUILD)/tools/gen_kallsyms
KALLSYMS_S = src/kernel/kallsyms_data.S

## Rootfs (trigger disk image rebuild when these change) 
ROOTFS_FILES = $(wildcard rootfs/*)


ifeq ($(V),1)
Q         =
else
Q         = @
endif
 
all: $(KERNEL) $(IMG) $(BOOT_IMG)

$(KERNEL): $(OBJECTS) $(GEN_KS)
	$(Q)printf "  LD      $@\n"
	$(Q)$(LD) $(LDFLAGS) -o $@.tmp $(OBJECTS)
	$(Q)nm -n -S $@.tmp | $(GEN_KS) > $(KALLSYMS_S)
	$(Q)$(AS) $(ASFLAGS) $(KALLSYMS_S) -o $(OBJ_DIR)/kallsyms_data.o
	$(Q)$(LD) $(LDFLAGS) -o $@ $(OBJECTS) $(OBJ_DIR)/kallsyms_data.o
	$(Q)rm -f $@.tmp
	$(Q)printf "  KERNEL  $@ (`wc -c < $@` bytes)\n"

$(IMG): $(MKJEXFS) $(ROOTFS_FILES)
	$(Q)printf "  IMG     $@\n"
	$(Q)./$(MKJEXFS) $@ 4096

$(OBJ_DIR)/%.o: src/%.c
	$(Q)mkdir -p $(@D)
	$(Q)printf "  CC      $<\n"
	$(Q)$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(OBJ_DIR)/%.o: src/%.s
	$(Q)mkdir -p $(@D)
	$(Q)printf "  AS      $<\n"
	$(Q)$(AS) $(ASFLAGS) $< -o $@


$(GEN_KS): tools/gen_kallsyms.c
	$(Q)mkdir -p $(@D)
	$(Q)printf "  HOSTCC $<\n"
	$(Q)$(HOSTCC) -o $@ $<

$(MKJEXFS): tools/mkjexfs.c
	$(Q)mkdir -p $(@D)
	$(Q)printf "  HOSTCC $<\n"
	$(Q)$(HOSTCC) -o $@ $<


$(ISO): $(KERNEL) $(IMG)
	$(Q)printf "  ISO     $@\n"
	$(Q)mkdir -p iso/boot/grub
	# grub.cfg loads fixed paths, so every flavor stages under the
	# same name -- otherwise a stale default kernel gets booted.
	$(Q)cp $(KERNEL) iso/boot/jexos.bin
	$(Q)cp $(IMG) iso/boot/jexos.img
	@if [ ! -f iso/boot/grub/grub.cfg ]; then \
		echo 'set timeout=5' > iso/boot/grub/grub.cfg; \
		echo 'menuentry "JexOS" {' >> iso/boot/grub/grub.cfg; \
		echo '    multiboot /boot/jexos.bin' >> iso/boot/grub/grub.cfg; \
		echo '    module /boot/jexos.img' >> iso/boot/grub/grub.cfg; \
		echo '    boot' >> iso/boot/grub/grub.cfg; \
		echo '}' >> iso/boot/grub/grub.cfg; \
	fi
	$(Q)grub2-mkrescue -o $@ iso

iso: $(ISO)

## Delivery image: hybrid ISO with a fresh rootfs appended at the tail.
## Attached as an IDE hard disk (86box), the kernel restores that tail
## over the RAM rootfs at mount and mirrors every rootfs write back
## into it, so history and files survive reboots from read-only media.
$(DELIVERY): $(ISO) $(IMG)
	$(Q)printf "  DELIVER $@\n"
	$(Q)cp $(ISO) $@
	$(Q)cat $(IMG) >> $@

deliver: $(DELIVERY)


## Boot image (native boot, no GRUB)

$(BOOTSECT): src/arch/i386/bootsect.s
	$(Q)mkdir -p $(BUILD)
	$(Q)printf "  AS      $<\n"
	$(Q)$(AS) $(ASFLAGS) $< -o $(BUILD)/bootsect.o
	$(Q)$(LD) -m elf_i386 -Ttext=0x7C00 -N -nostdlib $(BUILD)/bootsect.o -o $(BUILD)/bootsect.elf
	$(Q)$(OBJCOPY) --remove-section=.note.gnu.property -O binary $(BUILD)/bootsect.elf $@

$(LOADER): src/arch/i386/loader.s src/arch/i386/loader_defs.h
	$(Q)mkdir -p $(BUILD)
	$(Q)printf "  AS      $<\n"
	$(Q)$(AS) $(ASFLAGS) -Isrc/arch/i386 $< -o $(BUILD)/loader.o
	$(Q)$(LD) -m elf_i386 -Ttext=0x7E00 -N -nostdlib $(BUILD)/loader.o -o $(LOADER_ELF)
	$(Q)$(OBJCOPY) --remove-section=.note.gnu.property -O binary $(LOADER_ELF) $@

# mkbootimg.py patches the loader/bootsect DAP fields with the actual
# kernel size/LBA and lays the sectors out (see its docstring).
$(BOOT_IMG): $(BOOTSECT) $(LOADER) $(KERNEL)
	$(Q)printf "  BOOTIMG $@\n"
	$(Q)$(PYTHON) tools/mkbootimg.py \
		--bootsect $(BOOTSECT) --bootsect-elf $(BUILD)/bootsect.elf \
		--loader $(LOADER) --loader-elf $(LOADER_ELF) \
		--kernel $(KERNEL) --output $@

# Default boot path: GRUB ISO.  GRUB hands the kernel a real e820 memory
# map (the custom loader only fakes mem_lower/mem_upper) and lets the
# JexFS data disk live on hda, which the native bootloader cannot do
# because boot.img needs hda for itself.
run: $(ISO) $(IMG)
	$(Q)printf "  QEMU    %s (GRUB ISO)\n" "$(QEMU)"
	$(Q)$(QEMU) -cdrom $(ISO) -hda $(IMG) $(QEMU_OPTS)

# Headless self-test run: boots the test flavor, QEMU exits itself via
# the isa-debug-exit port when the suite finishes.  timeout catches a
# hung test -- the last "[RUN  ] <name>" line in the log names the
# culprit.  Exit codes: 33 = all passed, 7 = failures, 124 = timeout,
# anything else = QEMU died before or during boot.
test:
	$(Q)$(MAKE) FLAVOR=test iso

# stdin is /dev/null on purpose: with a real tty on stdin, qemu's
# stdio serial flips the terminal into raw mode and Ctrl-C stops
# working (it becomes a byte sent to the guest).  /dev/null keeps
# the tty cooked, serial still streams live to stdout.
SELFTEST_TIMEOUT ?= 90

run-test:
	$(Q)$(MAKE) FLAVOR=test iso
	$(Q)timeout $(SELFTEST_TIMEOUT) $(QEMU) -cdrom jexos-test.iso \
		-display none -serial stdio -no-reboot \
		-device isa-debug-exit,iobase=0xf4 </dev/null ; \
	status=$$?; \
	if [ $$status -eq 33 ]; then echo "  SELFTEST PASS"; \
	elif [ $$status -eq 7 ]; then echo "  SELFTEST FAIL (see log above)"; exit 1; \
	else echo "  SELFTEST HANG/CRASH (exit $$status, see log above)"; exit 1; fi

debug:
	$(Q)$(MAKE) FLAVOR=debug all

run-debug:
	$(Q)$(MAKE) FLAVOR=debug iso
	$(Q)$(QEMU) -cdrom jexos-debug.iso -hda jexos-debug.img $(QEMU_OPTS)

# Fallback: boot through the custom stage-1/stage-2 bootloader.
run-native: $(BOOT_IMG) $(IMG)
	$(Q)printf "  QEMU    %s (native bootloader)\n" "$(QEMU)"
	$(Q)$(QEMU) -hda $(BOOT_IMG) -hdb $(IMG) $(QEMU_OPTS)

# Backwards-compatible alias
boot: run-native


docs:
	$(Q)printf "  DOXYGEN\n"
	$(Q)doxygen Doxyfile

docs-run: docs
	$(Q)printf "  SERVE   http://localhost:8000\n"
	$(Q)cd docs/html && python3 -m http.server 8000


clean:
	$(Q)printf "  CLEAN\n"
	rm -rf $(BUILD) $(KERNEL) $(IMG) $(ISO) $(DELIVERY) $(KALLSYMS_S) $(BOOT_IMG) iso/

distclean: clean
	$(Q)printf "  DISTCLEAN\n"
	rm -rf iso/


help:
	@echo "JexOS Build System"
	@echo ""
	@echo "Targets:"
	@echo "  make              Build kernel + disk + boot image"
	@echo "  make run          Boot in QEMU via GRUB (GUI)"
	@echo "  make run-native   Boot via the custom bootloader"
	@echo "  make boot         Alias for run-native"
	@echo "  make docs         Generate HTML docs via Doxygen"
	@echo "  make docs-run     Generate docs + serve at :8000"
	@echo "  make iso          Build GRUB bootable ISO"
	@echo "  make deliver      Build delivery image (ISO + persistence mirror)"
	@echo "  make clean        Remove build artifacts"
	@echo "  make distclean    Remove everything"
	@echo ""
	@echo "Options:"
	@echo "  V=1               Verbose output"
	@echo "  DEBUG=1           Build with ftrace"
	@echo ""

-include $(DEPS)

.PHONY: all run run-native clean distclean iso deliver docs docs-run boot help debug run-debug test run-test
