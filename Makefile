# SPDX-License-Identifier: GPL-2.0-only
#
# Makefile - JexOS build system
#
# Targets:
#   all             Build kernel + disk image + boot image (default)
#   run             Boot in QEMU via GRUB (GUI) [default]
#   run-native      Boot in QEMU via the custom stage-1/2 bootloader
#   boot            Alias for run-native
#   clean           Remove build artifacts
#   distclean       Remove everything (incl. build directory)
#   docs            Generate Doxygen HTML documentation
#   iso             Build bootable GRUB ISO
#   help            Show this help
#
# Options:
#   V=1             Verbose output (show full commands)
#   DEBUG=1         Build with ftrace instrumentation

## Toolchain 
CC        = gcc
AS        = as
LD        = ld
HOSTCC    = gcc
OBJCOPY   = objcopy
NM        = nm
PYTHON    = python3
QEMU      = qemu-system-i386

## QEMU options shared by all run targets
# out.mixing-engine=off matters: with QEMU's software mixer in the path the
# AC'97 voice is fed a full mixer window per audio timer tick, which runs the
# stream ~2.3x faster than the codec rate.  Bypassing it hands the samples to
# the backend and the DMA position advances at the programmed 44.1 kHz.
# It also turns fixed settings off, so each voice opens the backend at its own
# format -- no resampler in the path.  That works because pa accepts
# 44.1 kHz / s16 / stereo and PipeWire converts to the device rate itself;
# a backend that insists on 48 kHz would play the stream fast.
QEMU_OPTS = -serial stdio \
            -smp 2 \
            -machine pcspk-audiodev=audio0 \
            -audiodev pa,id=audio0,out.mixing-engine=off \
            -netdev user,id=net0,hostfwd=tcp::8080-:80 \
            -device rtl8139,netdev=net0 \
            -device AC97,audiodev=audio0

## Architecture 
# -mno-80387 is a correctness guard, not an optimization.  Nothing saves the
# x87 state across a task switch, so a float in kernel C would silently
# corrupt whatever the preempted task had in its registers.  With the flag,
# such a float compiles to a soft-float call that nothing provides and the
# link fails -- loud, immediate, and impossible to miss.  See TODO.md
# "FPU/SSE State" before removing it.
CFLAGS    = -m32 -march=i486 -ffreestanding -std=gnu99 -fno-pie -fno-stack-protector
CFLAGS   += -mno-80387
CFLAGS   += -O2 -Wall -Wextra
CFLAGS   += -fno-omit-frame-pointer
CFLAGS   += -Isrc/include -Isrc/tests
ASFLAGS   = --32
LDFLAGS   = -m elf_i386 -T linker.ld -nostdlib

# ftrace support (see src/debug/ftrace.c)
ifeq ($(DEBUG),1)
CFLAGS += -finstrument-functions
endif

# Scheduler switch tracing: per-context-switch SAVE2/SW2 dumps for PID 2.
# Off by default -- it floods serial (~2000 lines/60s idle) and buries the
# boot log.  Enable with `make SWITCH_TRACE=1` when debugging the
# switch/trampoline path.
ifeq ($(SWITCH_TRACE),1)
CFLAGS += -DJEXOS_SWITCH_TRACE
endif

# Mutex-path counters (MTX f=/MTX-ALIVE) emitted from the tick handlers.
# Off by default -- two lines every ~200 slices forever.  Enable with
# `make MUTEX_TRACE=1` when a mutex wedge needs the transition counters.
ifeq ($(MUTEX_TRACE),1)
CFLAGS += -DJEXOS_MUTEX_TRACE
endif

## Output files
KERNEL    = jexos.bin
IMG       = jexos.img
ISO       = jexos.iso
DELIVERY  = jexosg.img
BUILD     = build
OBJ_DIR   = $(BUILD)/obj
BOOT_IMG  = jexos.boot.img

## GRUB menu wait.  measurement runs set this to 0 so the host timing
## does not include menu idle time.
GRUB_TIMEOUT ?= 5

## Build flavors: make / make debug / make test
#   debug: JEXOS_DEBUG  -- insanely verbose serial logging, normal shell boot
#   test:  JEXOS_SELFTEST -- same core + boots straight into the self-test
#          suite and exits QEMU via the isa-debug-exit port when done.
#   Each flavor gets its own object dir and artifact names so flavors
#   never clobber each other's stale objects.
FLAVOR =
ifeq ($(FLAVOR),debug)
CFLAGS   += -DJEXOS_DEBUG
KERNEL    = jexos-debug.bin
IMG       = jexos-debug.img
ISO       = jexos-debug.iso
DELIVERY  = jexosg-debug.img
OBJ_DIR   = $(BUILD)/obj-debug
endif
ifeq ($(FLAVOR),test)
CFLAGS   += -DJEXOS_SELFTEST -DJEXOS_DEBUG
KERNEL    = jexos-test.bin
IMG       = jexos-test.img
ISO       = jexos-test.iso
DELIVERY  = jexosg-test.img
OBJ_DIR   = $(BUILD)/obj-test
endif
ifeq ($(FLAVOR),boottime)
# Measurement clone of the debug flavor: same kernel plus a boot timer.
CFLAGS   += -DJEXOS_BOOTTIME -DJEXOS_DEBUG
KERNEL    = jexos-boottime.bin
IMG       = jexos-boottime.img
ISO       = jexos-boottime.iso
DELIVERY  = jexosg-boottime.img
OBJ_DIR   = $(BUILD)/obj-boottime
endif
BOOTSECT  = $(BUILD)/bootsect.bin
LOADER    = $(BUILD)/loader.bin
LOADER_ELF = $(BUILD)/loader.elf

## Source discovery
SRC_C     = $(shell find src -name '*.c' ! -path '*/lib/type.c')
SRC_S     = $(shell find src/arch -name '*.s' ! -name 'bootsect.s' ! -name 'loader.s')
OBJECTS   = $(patsubst src/%.c, $(OBJ_DIR)/%.o, $(SRC_C)) \
            $(patsubst src/%.s, $(OBJ_DIR)/%.o, $(SRC_S))

## Dependency files (auto-generated by -MMD) 
DEPS      = $(OBJECTS:.o=.d)

## Third-party code
# minimp3 is float-based and cannot be built with -mno-80387, so the x87 is
# switched back on for that one object only.  That is safe now that fpu.c
# saves a per-task FPU image on every switch; what it preserves is the guard
# everywhere else -- a stray float in any other kernel file still fails at
# link time instead of silently trashing a task's registers.
MP3_CFLAGS = -m80387 -Ithird_party
$(OBJ_DIR)/drivers/mp3.o: CFLAGS += $(MP3_CFLAGS)

## Flag stamp
# The object rules depend on the source and the generated .d files only, so
# editing CFLAGS used to reuse stale objects: the change looked applied while
# the binary still held the old code.  Each object dir keeps a stamp of the
# command line; touching it is enough to force a rebuild, and the recipe
# never rewrites the file unless the flags really changed.
FLAG_STAMP = $(OBJ_DIR)/.flags
FLAG_LINE  = $(CC) $(CFLAGS) $(MP3_CFLAGS) $(ASFLAGS) $(LDFLAGS)

## Host tools 
MKJEXFS   = $(BUILD)/tools/mkjexfs
MKJEXFS3  = $(BUILD)/tools/mkjexfs3
JEXFSCK3  = $(BUILD)/tools/jexfsck3
J3CRASH   = $(BUILD)/tools/j3crash
V3_JOURNAL_SRC = src/fs/jexfs3_journal.c
# Disk-boot ISO: same staging as $(ISO) but without the rootfs module.
RUN_ISO   = $(BUILD)/run-$(notdir $(ISO))
GEN_KS    = $(BUILD)/tools/gen_kallsyms
KALLSYMS_S = src/kernel/kallsyms_data.S

## Rootfs (trigger disk image rebuild when these change)
ROOTFS_FILES = $(wildcard rootfs/*)

## Rootfs staging for the disk image
# JexFS inodes store block numbers as u16 and the block bitmap is 8 blocks
# (65536 bits), so 65536 blocks -- 64 MB at 1 KB per block -- is the largest
# image the on-disk format can address.
IMG_BLOCKS ?= 65536

# MP3s in rootfs/ are re-encoded at image build time: the kernel decoder
# only accepts 44.1 kHz, and the lower bitrate keeps the image compact.
# rootfs/ itself is never modified, so the originals stay untouched.
ROOTFS_STAGE       = $(BUILD)/rootfs
ROOTFS_MP3_BITRATE ?= 96

## JexFS v3 test image
# Phase 1 mounts a host-built v3 image read-only.  The test flavor packs it
# into the v2 rootfs so the kernel can mount it through a file-backed block
# callback; other flavors stay lean.  The odd --split makes data.bin span
# five extents, which exercises the leaf extent block.
V3_TREE        = $(BUILD)/jexfs3tree
V3_TREE_STAMP  = $(BUILD)/jexfs3tree.stamp
V3_TEST_IMAGE  = $(BUILD)/jexfs3-test.img
V3_TEST_BLOCKS ?= 256
V3_TEST_JOURNAL ?= 64
V3_CRASH_DIR   = $(BUILD)/j3crash

# Small image for the in-kernel journal replay test.  It has to fit in a
# static buffer in the kernel (48 * 4 KB = 192 KB) and carries an 8-block
# journal, which is enough for the two-block transaction the test logs.
V3_JOURNAL_TREE       = $(BUILD)/jexfs3-journal-tree
V3_JOURNAL_TREE_STAMP = $(BUILD)/jexfs3-journal-tree.stamp
V3_JOURNAL_IMAGE      = $(BUILD)/jexfs3-journal-test.img
V3_JOURNAL_BLOCKS     ?= 48
V3_JOURNAL_LOG        ?= 8

ifeq ($(FLAVOR),test)
V3_PACK_DEP = $(V3_TEST_IMAGE) $(V3_JOURNAL_IMAGE)
V3_PACK_CMD = cp $(V3_TEST_IMAGE) $(ROOTFS_STAGE)/jexfs3.img && \
              cp $(V3_JOURNAL_IMAGE) $(ROOTFS_STAGE)/jexfs3-journal.img
else
V3_PACK_DEP =
V3_PACK_CMD = :
endif

## Generated audio sample
# Not committed: a four-second arpeggio at the codec's format (440/660/880/
# 1100 Hz, the same notes sndtest plays), so `play /test.mp3` and `sndtest`
# can be compared by ear or by capture.  Two files, because the stereo and
# mono decode paths differ: /test.mp3 is 64 kbit/s stereo, /test-mono.mp3
# is 32 kbit/s mono and exercises the channel duplication.  They are packed
# into the image from $(ASSETS_DIR) alongside rootfs/ (the user's untracked
# runtime directory) rather than being written into it.  Best-effort: without
# ffmpeg the image still builds, it just ships no sample.
ASSETS_DIR      = $(BUILD)/assets
MP3_ASSET       = $(ASSETS_DIR)/test.mp3
MP3_MONO_ASSET  = $(ASSETS_DIR)/test-mono.mp3
SAMPLE_SOURCE   = aevalsrc=0.35*sin(2*PI*(440+220*floor(t))*t):s=44100:d=4

$(MP3_ASSET):      MP3_CHANNELS = 2
$(MP3_ASSET):      MP3_BITRATE  = 64
$(MP3_MONO_ASSET): MP3_CHANNELS = 1
$(MP3_MONO_ASSET): MP3_BITRATE  = 32

$(MP3_ASSET) $(MP3_MONO_ASSET):
	$(Q)mkdir -p $(@D)
	$(Q)ffmpeg -hide_banner -loglevel error -y \
		-f lavfi -i "$(SAMPLE_SOURCE)" \
		-ac $(MP3_CHANNELS) -ar 44100 -c:a libmp3lame \
		-b:a $(MP3_BITRATE)k -f mp3 $@.part && mv $@.part $@ \
		|| { rm -f $@.part; printf "  WARN    ffmpeg unavailable, no sample mp3 in image\n"; }


ifeq ($(V),1)
Q         =
else
Q         = @
endif
 
all: $(KERNEL) $(IMG) $(BOOT_IMG)

$(KERNEL): $(OBJECTS) $(GEN_KS)
	$(Q)printf "  LD      $@\n"
	$(Q)$(LD) $(LDFLAGS) -o $@.tmp $(OBJECTS)
	$(Q)nm -n -S $@.tmp | $(GEN_KS) > $(KALLSYMS_S)
	$(Q)$(AS) $(ASFLAGS) $(KALLSYMS_S) -o $(OBJ_DIR)/kallsyms_data.o
	$(Q)$(LD) $(LDFLAGS) -o $@ $(OBJECTS) $(OBJ_DIR)/kallsyms_data.o
	$(Q)rm -f $@.tmp
	$(Q)printf "  KERNEL  $@ (`wc -c < $@` bytes)\n"

$(IMG): $(MKJEXFS) $(ROOTFS_FILES) $(MP3_ASSET) $(MP3_MONO_ASSET) $(V3_PACK_DEP)
	$(Q)printf "  IMG     $@\n"
	$(Q)rm -rf $(ROOTFS_STAGE) && mkdir -p $(ROOTFS_STAGE)
	$(Q)if [ -d rootfs ]; then \
		for f in rootfs/*.mp3; do \
			[ -e "$$f" ] || continue; \
			name=$${f##*/}; \
			printf "  MP3     %s -> %s kbit/s\n" "$$name" $(ROOTFS_MP3_BITRATE); \
			if ffmpeg -hide_banner -loglevel error -y -i "$$f" -vn \
				-map 0:a:0 -map_metadata -1 -id3v2_version 0 \
				-ar 44100 -c:a libmp3lame -b:a $(ROOTFS_MP3_BITRATE)k \
				-f mp3 "$(ROOTFS_STAGE)/$$name.part"; then \
				mv "$(ROOTFS_STAGE)/$$name.part" "$(ROOTFS_STAGE)/$$name"; \
			else \
				rm -f "$(ROOTFS_STAGE)/$$name.part"; \
				printf "  WARN    ffmpeg failed on %s, packing the original\n" "$$name"; \
				cp "$$f" "$(ROOTFS_STAGE)/$$name"; \
			fi; \
		done; \
		for f in rootfs/*; do \
			[ -e "$$f" ] || continue; \
			case "$$f" in *.mp3) continue;; esac; \
			cp "$$f" "$(ROOTFS_STAGE)/"; \
		done; \
	fi
	$(Q)$(V3_PACK_CMD)
	$(Q)./$(MKJEXFS) $@ $(IMG_BLOCKS) $(if $(ROOTFS_FILES),$(ROOTFS_STAGE)) $(ASSETS_DIR)

$(FLAG_STAMP): FORCE
	$(Q)mkdir -p $(@D)
	$(Q)printf '%s\n' '$(FLAG_LINE)' | cmp -s - $@ || \
	    printf '%s\n' '$(FLAG_LINE)' > $@

$(OBJ_DIR)/%.o: src/%.c $(FLAG_STAMP)
	$(Q)mkdir -p $(@D)
	$(Q)printf "  CC      $<\n"
	$(Q)$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(OBJ_DIR)/%.o: src/%.s $(FLAG_STAMP)
	$(Q)mkdir -p $(@D)
	$(Q)printf "  AS      $<\n"
	$(Q)$(AS) $(ASFLAGS) $< -o $@


$(GEN_KS): tools/gen_kallsyms.c
	$(Q)mkdir -p $(@D)
	$(Q)printf "  HOSTCC $<\n"
	$(Q)$(HOSTCC) -o $@ $<

$(MKJEXFS): tools/mkjexfs.c
	$(Q)mkdir -p $(@D)
	$(Q)printf "  HOSTCC $<\n"
	$(Q)$(HOSTCC) -o $@ $<

$(MKJEXFS3): tools/mkjexfs3.c src/include/jexfs3.h
	$(Q)mkdir -p $(@D)
	$(Q)printf "  HOSTCC $<\n"
	$(Q)$(HOSTCC) -Wall -Wextra -o $@ $<

$(JEXFSCK3): tools/jexfsck3.c $(V3_JOURNAL_SRC) src/include/jexfs3.h \
             src/include/jexfs3_journal.h
	$(Q)mkdir -p $(@D)
	$(Q)printf "  HOSTCC $<\n"
	$(Q)$(HOSTCC) -Wall -Wextra -Isrc/include -o $@ tools/jexfsck3.c \
		$(V3_JOURNAL_SRC)

$(J3CRASH): tools/j3crash.c $(V3_JOURNAL_SRC) src/include/jexfs3.h \
            src/include/jexfs3_journal.h
	$(Q)mkdir -p $(@D)
	$(Q)printf "  HOSTCC $<\n"
	$(Q)$(HOSTCC) -Wall -Wextra -Isrc/include -o $@ tools/j3crash.c \
		$(V3_JOURNAL_SRC)

# Fixed test tree: a small file, a 300 KB file split across five extents
# (leaf block), a 200 KB file with four inline extents, and two nesting
# levels.  The stamp keeps the tree from being rebuilt on every make while
# still picking up a clean build dir.
$(V3_TREE_STAMP): Makefile
	$(Q)rm -rf $(V3_TREE) && mkdir -p $(V3_TREE)/dir/sub
	$(Q)printf 'hello jexfs3\n' > $(V3_TREE)/hello.txt
	$(Q)dd if=/dev/zero bs=1000 count=300 2>/dev/null | tr '\0' 'A' > $(V3_TREE)/data.bin
	$(Q)dd if=/dev/zero bs=1000 count=200 2>/dev/null | tr '\0' 'B' > $(V3_TREE)/inline.bin
	$(Q)printf 'nested jexfs3\n' > $(V3_TREE)/dir/nested.txt
	$(Q)printf 'deep jexfs3\n' > $(V3_TREE)/dir/sub/deep.txt
	$(Q)touch $@

$(V3_TEST_IMAGE): $(MKJEXFS3) $(V3_TREE_STAMP)
	$(Q)printf "  JEXFS3  $@\n"
	$(Q)./$(MKJEXFS3) $@ $(V3_TEST_BLOCKS) --split=16 \
		--journal=$(V3_TEST_JOURNAL) $(V3_TREE)

# Tiny tree for the kernel-side journal test: one file is enough to prove
# replay did not disturb ordinary data.
$(V3_JOURNAL_TREE_STAMP): Makefile
	$(Q)rm -rf $(V3_JOURNAL_TREE) && mkdir -p $(V3_JOURNAL_TREE)
	$(Q)printf 'hello jexfs3\n' > $(V3_JOURNAL_TREE)/hello.txt
	$(Q)touch $@

$(V3_JOURNAL_IMAGE): $(MKJEXFS3) $(V3_JOURNAL_TREE_STAMP)
	$(Q)printf "  JEXFS3  $@\n"
	$(Q)./$(MKJEXFS3) $@ $(V3_JOURNAL_BLOCKS) \
		--journal=$(V3_JOURNAL_LOG) $(V3_JOURNAL_TREE)

# Host-side verification of the same image the kernel mounts.
check-v3: $(JEXFSCK3) $(V3_TEST_IMAGE)
	$(Q)./$(JEXFSCK3) $(V3_TEST_IMAGE) $(V3_TREE)

## Crash simulation: log a transaction, replay every truncation point of
## it, then run the full verifier over every resulting image.  No QEMU.
crash-sim: $(J3CRASH) $(JEXFSCK3) $(V3_TEST_IMAGE)
	$(Q)rm -rf $(V3_CRASH_DIR) && mkdir -p $(V3_CRASH_DIR)
	$(Q)./$(J3CRASH) $(V3_TEST_IMAGE) --out $(V3_CRASH_DIR)
	$(Q)set -e; for img in $(V3_CRASH_DIR)/*.img; do \
		./$(JEXFSCK3) $$img --replay >/dev/null || \
			{ echo "  CRASHSIM FAILED: $$img"; exit 1; }; \
	done
	$(Q)printf "  CRASHSIM %s image(s) verified\n" \
		"$$(ls $(V3_CRASH_DIR)/*.img | wc -l)"


## Build an ISO staging tree.  $(1) is the output name for the log line,
## $(2) the staging directory, and $(3) says whether to embed the rootfs
## module.  CD-only boots need the module; run targets always attach a
## disk and mount it directly, so there the module is dead weight -- and
## GRUB spends seconds reading its 64 MB before the kernel starts.
define iso_tree
	$(Q)printf "  ISO     $(1)\n"
	$(Q)rm -rf $(2) && mkdir -p $(2)/boot/grub
	$(Q)cp $(KERNEL) $(2)/boot/jexos.bin
	$(Q)if [ "$(3)" = "1" ]; then cp $(IMG) $(2)/boot/jexos.img; fi
	$(Q)printf 'set timeout=%s\n' '$(GRUB_TIMEOUT)' > $(2)/boot/grub/grub.cfg
	$(Q)printf 'menuentry "JexOS" {\n' >> $(2)/boot/grub/grub.cfg
	$(Q)printf '    multiboot /boot/jexos.bin\n' >> $(2)/boot/grub/grub.cfg
	$(Q)if [ "$(3)" = "1" ]; then printf '    module /boot/jexos.img\n' >> $(2)/boot/grub/grub.cfg; fi
	$(Q)printf '    boot\n' >> $(2)/boot/grub/grub.cfg
	$(Q)printf '}\n' >> $(2)/boot/grub/grub.cfg
endef

$(ISO): $(KERNEL) $(IMG)
	$(call iso_tree,$@,iso,1)
	$(Q)grub2-mkrescue -o $@ iso

# GRUB menu / module paths are fixed, so each flavor stages under the
# same name; a stale default kernel must never be booted.
$(RUN_ISO): $(KERNEL) $(IMG)
	$(call iso_tree,$@,$(BUILD)/iso-run,0)
	$(Q)grub2-mkrescue -o $@ $(BUILD)/iso-run

iso: $(ISO)

## Delivery image: hybrid ISO with a fresh rootfs appended at the tail.
## Attached as an IDE hard disk (86box), the kernel finds that tail and
## mounts it directly -- it is the live rootfs, so writes persist without
## a mirror copy.
$(DELIVERY): $(ISO) $(IMG)
	$(Q)printf "  DELIVER $@\n"
	$(Q)cp $(ISO) $@
	$(Q)cat $(IMG) >> $@

deliver: $(DELIVERY)


## Boot image (native boot, no GRUB)

$(BOOTSECT): src/arch/i386/bootsect.s
	$(Q)mkdir -p $(BUILD)
	$(Q)printf "  AS      $<\n"
	$(Q)$(AS) $(ASFLAGS) $< -o $(BUILD)/bootsect.o
	$(Q)$(LD) -m elf_i386 -Ttext=0x7C00 -N -nostdlib $(BUILD)/bootsect.o -o $(BUILD)/bootsect.elf
	$(Q)$(OBJCOPY) --remove-section=.note.gnu.property -O binary $(BUILD)/bootsect.elf $@

$(LOADER): src/arch/i386/loader.s src/arch/i386/loader_defs.h
	$(Q)mkdir -p $(BUILD)
	$(Q)printf "  AS      $<\n"
	$(Q)$(AS) $(ASFLAGS) -Isrc/arch/i386 $< -o $(BUILD)/loader.o
	$(Q)$(LD) -m elf_i386 -Ttext=0x7E00 -N -nostdlib $(BUILD)/loader.o -o $(LOADER_ELF)
	$(Q)$(OBJCOPY) --remove-section=.note.gnu.property -O binary $(LOADER_ELF) $@

# mkbootimg.py patches the loader/bootsect DAP fields with the actual
# kernel size/LBA and lays the sectors out (see its docstring).
$(BOOT_IMG): $(BOOTSECT) $(LOADER) $(KERNEL)
	$(Q)printf "  BOOTIMG $@\n"
	$(Q)$(PYTHON) tools/mkbootimg.py \
		--bootsect $(BOOTSECT) --bootsect-elf $(BUILD)/bootsect.elf \
		--loader $(LOADER) --loader-elf $(LOADER_ELF) \
		--kernel $(KERNEL) --output $@

# Default boot path: GRUB ISO.  GRUB hands the kernel a real e820 memory
# map (the custom loader only fakes mem_lower/mem_upper) and lets the
# JexFS data disk live on hda, which the native bootloader cannot do
# because boot.img needs hda for itself.
#
# Boot a runtime copy of the image: the disk is the live rootfs now, not a
# mirror, so guest writes would otherwise dirty the build artifact.
RUN_DISK = $(BUILD)/run-$(notdir $(IMG))

$(RUN_DISK): $(IMG)
	$(Q)mkdir -p $(@D)
	$(Q)cp $(IMG) $@

run: $(RUN_ISO) $(RUN_DISK)
	$(Q)printf "  QEMU    %s (disk rootfs, no module)\n" "$(QEMU)"
	$(Q)$(QEMU) -cdrom $(RUN_ISO) -hda $(RUN_DISK) $(QEMU_OPTS)

# Headless self-test run: boots the test flavor, QEMU exits itself via
# the isa-debug-exit port when the suite finishes.  timeout catches a
# hung test -- the last "[RUN  ] <name>" line in the log names the
# culprit.  Exit codes: 33 = all passed, 7 = failures, 124 = timeout,
# anything else = QEMU died before or during boot.
test:
	$(Q)$(MAKE) FLAVOR=test iso

# stdin is /dev/null on purpose: with a real tty on stdin, qemu's
# stdio serial flips the terminal into raw mode and Ctrl-C stops
# working (it becomes a byte sent to the guest).  /dev/null keeps
# the tty cooked, serial still streams live to stdout.
SELFTEST_TIMEOUT ?= 90

run-test:
	$(Q)$(MAKE) FLAVOR=test iso
	$(Q)timeout $(SELFTEST_TIMEOUT) $(QEMU) -cdrom jexos-test.iso \
		-display none -serial stdio -no-reboot \
		-device isa-debug-exit,iobase=0xf4 </dev/null ; \
	status=$$?; \
	if [ $$status -eq 33 ]; then echo "  SELFTEST PASS"; \
	elif [ $$status -eq 7 ]; then echo "  SELFTEST FAIL (see log above)"; exit 1; \
	else echo "  SELFTEST HANG/CRASH (exit $$status, see log above)"; exit 1; fi

debug:
	$(Q)$(MAKE) FLAVOR=debug all

run-debug:
	$(Q)$(MAKE) FLAVOR=debug run

## Boot-time measurement: a debug clone that times kernel entry ->
## shell ready and powers off at the prompt.  run-boottime keeps the
## normal GRUB menu so a human can pick the entry; measure-boot zeroes
## the menu wait and reports the host wall time around QEMU.
run-boottime:
	$(Q)$(MAKE) FLAVOR=boottime run

BOOTTIME_TIMEOUT ?= 120

measure-boot:
	$(Q)$(MAKE) FLAVOR=boottime $(BUILD)/run-jexos-boottime.img
	$(Q)rm -f $(BUILD)/run-jexos-boottime.iso
	$(Q)$(MAKE) FLAVOR=boottime GRUB_TIMEOUT=0 $(BUILD)/run-jexos-boottime.iso
	$(Q)start=$$(date +%s%N); \
	timeout $(BOOTTIME_TIMEOUT) $(QEMU) -cdrom $(BUILD)/run-jexos-boottime.iso \
		-hda $(BUILD)/run-jexos-boottime.img \
		-display none -serial stdio -no-reboot -smp 2 \
		-netdev user,id=net0,hostfwd=tcp::8080-:80 \
		-device rtl8139,netdev=net0 \
		-device AC97,audiodev=audio0 -audiodev none,id=audio0 \
		</dev/null; \
	status=$$?; end=$$(date +%s%N); \
	printf "  HOST TOTAL %s ms (qemu launch -> poweroff, GRUB included)\n" \
		"$$(( (end - start) / 1000000 ))"; \
	[ $$status -eq 0 ] || echo "  qemu exit $$status"

# Fallback: boot through the custom stage-1/stage-2 bootloader.
run-native: $(BOOT_IMG) $(IMG)
	$(Q)printf "  QEMU    %s (native bootloader)\n" "$(QEMU)"
	$(Q)$(QEMU) -hda $(BOOT_IMG) -hdb $(IMG) $(QEMU_OPTS)

# Backwards-compatible alias
boot: run-native


docs:
	$(Q)printf "  DOXYGEN\n"
	$(Q)doxygen Doxyfile

docs-run: docs
	$(Q)printf "  SERVE   http://localhost:8000\n"
	$(Q)cd docs/html && python3 -m http.server 8000


clean:
	$(Q)printf "  CLEAN\n"
	rm -rf $(BUILD) $(KERNEL) $(IMG) $(ISO) $(DELIVERY) $(KALLSYMS_S) $(BOOT_IMG) iso/

distclean: clean
	$(Q)printf "  DISTCLEAN\n"
	rm -rf iso/


help:
	@echo "JexOS Build System"
	@echo ""
	@echo "Targets:"
	@echo "  make              Build kernel + disk + boot image"
	@echo "  make run          Boot in QEMU via GRUB (GUI)"
	@echo "  make run-native   Boot via the custom bootloader"
	@echo "  make boot         Alias for run-native"
	@echo "  make docs         Generate HTML docs via Doxygen"
	@echo "  make docs-run     Generate docs + serve at :8000"
	@echo "  make iso          Build GRUB bootable ISO"
	@echo "  make check-v3     Verify the host-built JexFS v3 test image"
	@echo "  make run-boottime Boot the timer build; powers off at shell ready"
	@echo "  make measure-boot Time qemu launch -> shell ready -> poweroff"
	@echo "  make deliver      Build delivery image (ISO + persistence mirror)"
	@echo "  make clean        Remove build artifacts"
	@echo "  make distclean    Remove everything"
	@echo ""
	@echo "Options:"
	@echo "  V=1               Verbose output"
	@echo "  DEBUG=1           Build with ftrace"
	@echo ""

-include $(DEPS)

.PHONY: all run run-native clean distclean iso deliver docs docs-run boot help debug run-debug test run-test check-v3 crash-sim run-boottime measure-boot FORCE

FORCE:
